{
  "name": "free-intelligence-film",
  "version": "1.0.0",
  "description": "A 70-second Remotion field report about the difference between model answers and accountable agent harnesses.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.504",
    "@remotion/media": "4.0.504",
    "@remotion/tailwind-v4": "4.0.504",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.504",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.504",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:film": "remotion render src/index.ts FreeIntelligenceReport ../public/free-intelligence-report.mp4 --codec=h264 --crf=20",
    "render:poster": "remotion still src/index.ts FreeIntelligencePoster ../public/film-poster.png",
    "render:og": "remotion still src/index.ts FreeIntelligenceOg ../public/og.png",
    "render:all": "npm run render:film && npm run render:poster && npm run render:og"
  },
  "sideEffects": [
    "*.css"
  ]
}
